# Path to the SQLite database file. Defaults to ./data/clips.db if unset.
DATABASE_PATH=./data/clips.db

# Path to the Drizzle migrations folder. Defaults to ./drizzle if unset.
MIGRATIONS_FOLDER=./drizzle

# Port the realtime websocket service listens on. Defaults to 3001 if unset.
REALTIME_PORT=3001

# Shared secret the web process must present to POST /emit on the realtime
# service. Required — the realtime service refuses to start without it.
# Generate one with: openssl rand -hex 32
EMIT_SECRET=replace-with-output-of-openssl-rand-hex-32

# Local development only: username to use when Authentik headers are absent.
# Ignored when NODE_ENV=production.
DEV_AUTH_USERNAME=sam

# Where uploaded, transcoded, and thumbnail media files are stored on disk.
# Defaults to ./data/media if unset. In the container this is set to /media
# by the Dockerfile; that path MUST be bind-mounted from the same host
# directory into both this container and the Caddy container that serves
# /media, or playback will 404 and uploads will be lost on recreate.
MEDIA_ROOT=/media
